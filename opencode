#!/usr/bin/env bash

export COMPOSE_SERVICE="opencode"
export DATA_DIR="${HOME}/.config/opencode"
export TOOL_CMD="${HOME}/.opencode/bin/opencode"

export BUILTIN_ENV="OPENCODE_OFFLINE=1
OPENCODE_AIRGAPPED=1"

# Path to the internal engine
LAUNCH_SCRIPT="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/internal/launch.sh"

# shellcheck source=internal/launch.sh
exec "$LAUNCH_SCRIPT" "$@"
